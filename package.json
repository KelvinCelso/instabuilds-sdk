{
  "name": "instabuilds",
  "version": "1.0.2",
  "description": "Session recording and user behavior tracking SDK for web applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.mjs",
      "require": "./dist/react/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "session-recording",
    "analytics",
    "user-tracking",
    "web-analytics",
    "rrweb",
    "react",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/KelvinCelso/instabuilds-sdk.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.2.64",
    "@types/uuid": "^9.0.8",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "rrweb": "^2.0.0-alpha.4",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  }
}